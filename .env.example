# ---------------------------------------------------------------------------
# Deep Agent GA — configuration template
#
#   cp .env.example .env      # then fill in the values you need
#
# `.env` is git-ignored. Everything here is read by stream-backend/app/settings.py,
# which loads (in order) ./.env, stream-backend/.env, and <repo-root>/.env —
# a real exported environment variable always wins over a .env entry.
#
# Only the keys for the provider you actually use are required. Anything left
# unset falls back to the non-secret defaults in app/settings.py (DEFAULTS).
# ---------------------------------------------------------------------------

# ===========================================================================
# 1. Model + tool credentials  (SECRET — never commit real values)
# ===========================================================================

# Web search. Required by every research assistant (tavily_search tool).
# Free tier: https://www.tavily.com/
TAVILY_API_KEY=

# Pick ONE provider below to match RESEARCH_AGENT_PROVIDER (section 3).
# Google Gemini — https://ai.google.dev/gemini-api/docs
GOOGLE_API_KEY=
# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# LangSmith tracing. Required only by the `langgraph dev` local server.
# https://smith.langchain.com/settings
LANGSMITH_API_KEY=

# AWS Bedrock. Prefer the ambient credential chain (an SSO/CLI profile locally,
# IRSA in EKS) over static keys — leave these blank if you have one.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEDROCK_PROFILE=my-profile

# ===========================================================================
# 2. Backend topology — where state and events live
# ===========================================================================

# memory  = single process, nothing persisted (default; fine for a quick try)
# postgres = durable threads/runs/events; required for the Celery worker
STREAM_BACKEND_STORE=memory
# Only read when STREAM_BACKEND_STORE=postgres. POSTGRES_URI and DATABASE_URL
# are accepted as aliases.
# STREAM_BACKEND_POSTGRES_URI=postgresql://postgres:CHANGE_ME@localhost:5432/deepresearch

# memory   = in-process fan-out (default; SSE only works inside one process)
# rabbitmq = RabbitMQ Streams, so worker-produced events reach API-connected clients
STREAM_BACKEND_EVENT_BROKER=memory
# RabbitMQ Streams protocol, port 5552 (NOT the AMQP port).
# RABBITMQ_STREAM_URL=rabbitmq-stream://guest:CHANGE_ME@127.0.0.1:5552/

# asyncio = runs execute inside the API process (default)
# celery  = runs are enqueued onto the worker (needs postgres + rabbitmq above)
STREAM_BACKEND_RUNNER_BACKEND=asyncio
# Celery's task queue — classic AMQP, port 5672.
# STREAM_BACKEND_CELERY_BROKER_URL=amqp://guest:CHANGE_ME@localhost:5672//
STREAM_BACKEND_CELERY_QUEUE=deep-agent-ga-runs

# filesystem = assistants are folders on disk (baked into the image, or a shared
#              RWX volume). pg = assistant configs + skill/memory files live in
#              Postgres, so the apiserver and worker share them with no volume.
STREAM_BACKEND_ASSISTANT_STORE=filesystem
# STREAM_BACKEND_ASSISTANTS_DIR=/data/assistants

# ===========================================================================
# 3. Agent defaults
# ===========================================================================

# Fallback provider/model. Each assistant normally pins its own; these apply
# only when an assistant does not. One of: google | anthropic | openai | bedrock
RESEARCH_AGENT_PROVIDER=google
# RESEARCH_AGENT_MODEL=gemini-3-pro-preview

# Bedrock region (RESEARCH_AGENT_AWS_REGION and AWS_BEDROCK_REGION also accepted).
# AWS_REGION=us-east-1

# auto = real agent, falling back to the deterministic fixture if it is
#        unavailable; research = real agent only; fixture = scripted events
STREAM_BACKEND_AGENT_MODE=auto

# Super-step ceiling for one run. A deep run fans out into subagents and can
# exceed LangGraph's default of 25; the backend defaults this to 50.
# LANGGRAPH_RECURSION_LIMIT=50

# ===========================================================================
# 4. Logging
# ===========================================================================
STREAM_BACKEND_LOG_LEVEL=INFO
STREAM_BACKEND_LIBRARY_LOG_LEVEL=WARNING
STREAM_BACKEND_LOG_COLOR=true
# STREAM_BACKEND_LOG_FILE=/tmp/deep-agent-ga-stream-backend.log

# ===========================================================================
# 5. Frontend (ui/) — not read from this file
# ===========================================================================
# The SPA has no build-time API constant: it reads window.__API_URL__ from
# /config.js, which is written at container start by ui/docker-entrypoint.sh
# from the API_URL env (Helm: ui.apiUrl). For `npm run dev`, point the SPA at a
# locally running backend by editing ui/public/config.js:
#     window.__API_URL__ = "http://localhost:8123";
# Left empty, the SPA falls back to http://localhost:2024 (the `langgraph dev`
# server) on localhost, or same-origin "/api" on any real hostname.

# Rendered by nginx's built-in envsubst at container start (20-envsubst-on-templates.sh).
# Only ${APISERVER_UPSTREAM} is substituted; nginx runtime vars like $host are left intact.

# WebSocket upgrade helper: "upgrade" when the client asks, "close" otherwise.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Access-log line that shows, per request, which upstream was hit and what it
# returned — so `kubectl logs deploy/<release>-ui` reveals whether /api/* calls
# actually reached the apiserver (upstream=...) and its status/latency.
log_format dr_upstream '$remote_addr host=$host "$request" '
    'status=$status bytes=$body_bytes_sent '
    'upstream=$upstream_addr upstream_status=$upstream_status '
    'req_time=$request_time upstream_time=$upstream_response_time '
    'ref="$http_referer"';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    access_log /dev/stdout dr_upstream;
    error_log  /dev/stderr warn;

    # Never cache the runtime config or the entrypoint HTML.
    location = /config.js {
        add_header Cache-Control "no-store";
    }
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # SPA: fall back to index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse-proxy the backend so the browser stays same-origin (no CORS).
    # /api/threads/... -> ${APISERVER_UPSTREAM}/threads/...
    location /api/ {
        proxy_pass ${APISERVER_UPSTREAM}/;
        proxy_http_version 1.1;

        # WebSocket upgrade (protocol events stream).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events: disable buffering and let streams stay open.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding on;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # --- Diagnostics -------------------------------------------------------
    # What this container was configured with (written by docker-entrypoint.sh).
    #   curl http://<host>/__debug
    location = /__debug {
        default_type application/json;
        add_header Cache-Control "no-store";
        alias /usr/share/nginx/html/__debug.json;
    }

    # Live end-to-end check of the UI->apiserver proxy path: this proxies to the
    # backend's /health THROUGH this pod's nginx, so a 200 here proves the UI can
    # reach the apiserver. A 502/504 means the upstream is unreachable.
    #   curl http://<host>/__api_health
    location = /__api_health {
        add_header Cache-Control "no-store";
        proxy_pass ${APISERVER_UPSTREAM}/health;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }
}
